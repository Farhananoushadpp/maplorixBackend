# Production Environment Configuration
NODE_ENV=production
PORT=4000

# Production Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/maplorix_prod

# Production JWT Configuration
JWT_SECRET=your-super-secure-production-jwt-secret-key-change-this-immediately
JWT_EXPIRE=7d

# Production Email Configuration
EMAIL_HOST=mail.maplorix.ae
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=hr@maplorix.ae
EMAIL_PASS=Maplorix@2026
EMAIL_FROM="Maplorix HR <hr@maplorix.ae>"
# Production File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Production Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Production CORS Configuration
FRONTEND_URL=https://maplorix.ae

# Production Security
BCRYPT_ROUNDS=12

# reCAPTCHA Configuration
# Set RECAPTCHA_ENABLED=false to disable server-side reCAPTCHA verification
# (use when frontend reCAPTCHA widget is not producing valid Google tokens)
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=6LfxedwsAAAAACoxkr2xukshbEKn-JU663ln_Zv6
