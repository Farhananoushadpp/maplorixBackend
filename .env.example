# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/maplorix

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Email Configuration (for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=info@maplorix.com

# File Upload Configuration
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# reCAPTCHA Configuration
# Set RECAPTCHA_ENABLED=false to disable server-side reCAPTCHA verification
# (use when frontend reCAPTCHA widget is not producing valid Google tokens)
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=6LfxT9wsAAAAAPtrJbyfXnaJdmtCyoHQO1Ihc7Ps
RECAPTCHA_SITE_KEY=6LfxT9wsAAAAAK9kJC6lalLPIWWqvwSyo1aLs4aw
